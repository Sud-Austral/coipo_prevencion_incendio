# Auto detect text files and perform LF normalization
* text=auto

# Binarios: nunca normalizar saltos de línea (corrompería el contenido).
*.shp     binary
*.shx     binary
*.dbf     binary
*.sbn     binary
*.sbx     binary
*.qix     binary
*.xlsx    binary
*.xls     binary
*.kmz     binary
*.rar     binary
*.pdf     binary
*.docx    binary
*.qgz     binary
*.lpkx    binary
*.pmtiles binary
*.png     binary
*.jpg     binary
*.jpeg    binary

# Texto: LF explícito para que el ETL produzca el mismo byte en Windows y en el runner.
*.geojson text eol=lf
*.json    text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.jsx     text eol=lf
*.css     text eol=lf
*.yml     text eol=lf
*.ipynb   text eol=lf

# Insumo del modelo de riesgo (lab/priorizacion, notebook 4) y su salida por comuna.
# El CSV se versiona byte a byte como sale del lab (CRLF y BOM), para que su sha256
# siga siendo el del original. Y sin diff de lineas: son 188 MB de insumo y 163 MiB
# de salida en archivos de una sola linea, que git intentaria comparar linea a linea.
INSUMO_RIESGO/*.csv            -text
INSUMO_RIESGO/**               -diff
frontend/public/data/riesgo/** -diff
