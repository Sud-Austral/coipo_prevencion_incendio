{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    "no-undef": "error",
    "react/jsx-no-duplicate-props": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "env": { "browser": false, "node": true }
    }
  ]
}
